<!-- Contact Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-5 wow fadeIn" data-wow-delay="0.1s">
                <iframe class="w-100 h-100 rounded"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3001156.4288297426!2d-78.01371936852176!3d42.72876761954724!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4ccc4bf0f123a5a9%3A0xddcfc6c1de189567!2sNew%20York%2C%20USA!5e0!3m2!1sen!2sbd!4v1603794290143!5m2!1sen!2sbd"
                        frameborder="0" style="min-height: 400px; border:0;" allowfullscreen="" aria-hidden="false"
                        tabindex="0"></iframe>
            </div>
            <div class="col-lg-7 wow fadeIn" data-wow-delay="0.3s">
                <h6 class="section-title text-primary">Contact</h6>
                <h1 class="display-5 mb-4 wow fadeIn" data-wow-delay="0.2s">If You Have Any Query, Please Contact Us</h1>
                <form>
                    <div class="row g-3">
                        <div class="col-sm-6 control-group">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="name" placeholder="Your Name" />
                                <label for="name">Your Name</label>
                            </div>
                        </div>
                        <div class="col-sm-6 control-group">
                            <div class="form-floating">
                                <input type="email" class="form-control" id="email" placeholder="Your Email" />
                                <label for="email">Your Email</label>
                            </div>
                        </div>
                        <div class="col-sm-6 control-group">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="mobile" placeholder="Mobile" />
                                <label for="mobile">Mobile</label>
                            </div>
                        </div>
                        <div class="col-sm-6 control-group">
                            <div class="form-floating">
                                <input type="text" class="form-control" id="subject" placeholder="Subject" />
                                <label for="subject">Subject</label>
                            </div>
                        </div>
                        <div class="col-12 control-group">
                            <div class="form-floating">
                                <textarea style="height: 200px" class="form-control" id="message" placeholder="Message"></textarea>
                                <label for="message">Leave a message here</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary py-3 px-4" type="submit">Send Message</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- Contact End -->